# Gemini powers Vee when set (get a key at https://aistudio.google.com/apikey).
# Without it, Vee runs on the built-in offline demo engine.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Ringg voice API (see lib/integrations/ringg.ts). Calls are simulated until this is wired up.
# RINGG_API_KEY=
# RINGG_AGENT_ID=

# Supabase storage (recommended for Vercel). Without these, data is stored in data/runtime/db.json.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional, preferred if set (keep it server-side only):
# SUPABASE_SERVICE_ROLE_KEY=
